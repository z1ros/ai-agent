# Copy to .env and adjust. Every value here is optional: the service runs with
# no configuration at all, using the inference provider.

# --- Providers --------------------------------------------------------------
# Comma-separated, in priority order. Earlier providers win confidence ties.
ENABLED_PROVIDERS=inference
PROVIDER_TIMEOUT_SECONDS=10.0

# --- Resilience -------------------------------------------------------------
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=0.5
RATE_LIMIT_PER_SECOND=10.0
RATE_LIMIT_BURST=20

# --- Cache ------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=10000

# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Optional LLM signature parsing ----------------------------------------
# Only needed if you enable an LLM-backed provider.
# GOOGLE_API_KEY=
# MODEL_NAME=gemini-2.0-flash
